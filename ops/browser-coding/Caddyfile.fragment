# Insert inside the rumbo.datacodemath.com site block.
redir /code /code/ 308
handle /code/login {
	reverse_proxy 127.0.0.1:8000
}
handle /code/unlock {
	reverse_proxy 127.0.0.1:8000
}
handle /code/* {
	forward_auth 127.0.0.1:8000 {
		uri /code/auth
	}
	uri strip_prefix /code
	reverse_proxy 127.0.0.1:8443
}
